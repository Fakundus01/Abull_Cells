# back/.env.example  —  plantilla. Copiar a back/.env y completar.
# NO commitear back/.env (tiene secretos reales).

# --- Obligatorias: la app no arranca sin estas ---
SECRET_KEY=cambiar-por-cadena-aleatoria-larga
JWT_SECRET_KEY=otra-cadena-aleatoria-distinta
DATABASE_URL=postgresql://postgres.REF:PASSWORD@aws-1-REGION.pooler.supabase.com:5432/postgres?sslmode=require
FRONTEND_URL=http://localhost:5173

# Necesaria para que `flask db upgrade` funcione en el pre-deploy de Railway
FLASK_APP=app.py

# URL publica del backend. En Railway se deduce sola de RAILWAY_PUBLIC_DOMAIN.
BACKEND_URL=http://localhost:5000

# --- Cookies / JWT ---
# Dejar vacias en local. En produccion con front y back en dominios distintos:
#   JWT_COOKIE_SECURE=true  y  JWT_COOKIE_SAMESITE=None
JWT_COOKIE_SECURE=
JWT_COOKIE_SAMESITE=
JWT_COOKIE_DOMAIN=

# --- Email (Gmail SMTP con App Password, no la clave de la cuenta) ---
EMAIL_SENDER=tu-cuenta@gmail.com
EMAIL_PASSWORD=app-password-de-16-caracteres
EMAIL_ADMIN=tu-cuenta@gmail.com
EMAIL_TEST_RECEIVER=tu-cuenta@gmail.com

# --- Datos del local (se muestran en el front) ---
LOCAL_PICKUP_ADDRESS=Azcuenaga 185, CABA
LOCAL_PICKUP_HOURS=Lun a Sab 9:00 a 18:00
LOCAL_PICKUP_WHATSAPP=+54 11 5098-3612

# --- Mercado Pago ---
MP_ACCESS_TOKEN=APP_USR-...
MP_SUCCESS_URL=http://localhost:5173/checkout/success
MP_FAILURE_URL=http://localhost:5173/checkout/failure
MP_PENDING_URL=http://localhost:5173/checkout/pending
MP_WEBHOOK_URL=http://localhost:5000/api/payments/mp/webhook

# --- Imagenes de productos (Cloudinary evita necesitar disco persistente) ---
PRODUCT_IMAGE_STORAGE=cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_SECURE=true
CLOUDINARY_PRODUCT_FOLDER=products
# Carpeta de la Media Library que se muestra en el panel. La cuenta puede tener
# carpetas de otros clientes; sin esto se mezclarian catalogos ajenos.
CLOUDINARY_ASSET_FOLDER=products_clientes/Productos_abul

# --- OpenAI: sugerir titulo y descripcion desde la foto del producto ---
# Opcional. Sin la key el panel funciona igual, solo sin el boton de sugerencias.
# Costo medido: ~USD 0.0005 por imagen con gpt-4o-mini.
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4o-mini

# --- Uploads del formulario de contacto ---
MAX_UPLOAD_MB=8
UPLOAD_TEMP_DIR=/tmp/abul_cells_uploads

# --- Reservas de stock ---
ORDER_RESERVATION_MINUTES=30

# --- Seed opcional del usuario admin al arrancar ---
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrador

# --- Pool de conexiones (defaults pensados para el pooler de Supabase) ---
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_RECYCLE=280
